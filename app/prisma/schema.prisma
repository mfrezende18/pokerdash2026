generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SystemSettings {
  id              String   @id @default(cuid())
  showRakeToUsers Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String?   @unique
  phone             String?   @unique
  pixKey            String?
  passwordHash      String?
  requirePasswordChange Boolean @default(false)
  role              String    @default("USER") // ADMIN1, ADMIN2, USER
  avatarUrl         String?
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  buyIns            BuyIn[]
  cashOuts          CashOut[]
  createdSessions   Session[]   @relation("SessionCreator")
  createdEvents     Event[]     @relation("EventCreator")
  createdHighlights Highlight[] @relation("HighlightCreator")
}

model Session {
  id            String    @id @default(cuid())
  name          String
  blinds        String    @default("1/2")
  rakePercent   Float     @default(0)
  rakeFixed     Float     @default(0)
  rakeType      String    @default("NONE") // PERCENT, FIXED, NONE
  rakeCollected Float     @default(0)
  status        String    @default("ACTIVE") // ACTIVE, CLOSED
  startedAt     DateTime  @default(now())
  closedAt      DateTime?
  createdById   String

  createdBy     User      @relation("SessionCreator", fields: [createdById], references: [id])
  buyIns        BuyIn[]
  cashOuts      CashOut[]

  @@index([status])
  @@index([createdById])
}

model BuyIn {
  id        String   @id @default(cuid())
  sessionId String
  playerId  String
  amount    Float
  type      String   @default("INITIAL") // INITIAL, REBUY
  status    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player    User     @relation(fields: [playerId], references: [id])

  @@index([sessionId])
  @@index([playerId])
}

model CashOut {
  id        String   @id @default(cuid())
  sessionId String
  playerId  String
  chipValue Float
  netResult Float
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player    User     @relation(fields: [playerId], references: [id])

  @@index([sessionId])
  @@index([playerId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  ctaText     String?
  ctaUrl      String?
  eventDate   DateTime
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User     @relation("EventCreator", fields: [createdById], references: [id])

  @@index([eventDate])
}

model Highlight {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String
  imageUrl    String?
  badge       String?
  badgeColor  String   @default("primary") // primary, tertiary, black
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User     @relation("HighlightCreator", fields: [createdById], references: [id])
}
